# Copy to /home/dockerapps/hungry-hippos/.env on the server (next to update-app.sh).

# Postgres credentials (used by the app and db services)
POSTGRES_USER=hh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hungry_hippos

# Optional: Claude API key for importing recipe pages that lack structured recipe data.
# Leave empty to turn AI import off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Timezone for "today" and the current week
TZ=America/Detroit
