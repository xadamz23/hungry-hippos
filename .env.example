# Copy to .env next to compose.yml on the server.

# Postgres credentials (used by app, db and backup services)
POSTGRES_USER=hh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hungry_hippos

# Optional: Claude API key for importing recipe pages that lack structured recipe data.
# Leave empty to turn AI import off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Timezone for "today", the current week, and backup times
TZ=America/Detroit
BACKUP_HOUR=3

# Host port for the app (point Cloudflare Tunnel / your reverse proxy here)
APP_PORT=8000
# IMAGE=xadamz23/hungry-hippos:latest
